########################################
# API Server
########################################
API_BIND_ADDRESS=0.0.0.0
API_PORT=8000
UVICORN_WORKERS=2
WAIT_TIMEOUT_SECONDS=120

########################################
# Database / Cache
########################################
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=smarf_trading_db
POSTGRES_PORT=5432
POSTGRES_BIND_ADDRESS=127.0.0.1

REDIS_HOST=redis
REDIS_PASSWORD=change_me_redis
REDIS_PORT=6379
REDIS_BIND_ADDRESS=127.0.0.1

DATABASE_URL=postgresql://admin:change_me_postgres@postgres:5432/smarf_trading_db

########################################
# App Security
########################################
JWT_SECRET=replace_me_jwt
SECRET_KEY=replace_me_secret_key
TURNSTILE_SECRET_KEY=replace_me_turnstile

########################################
# Email
########################################
RESEND_API_KEY=replace_me_resend
EMAIL_FROM="SmarfRobotTrade <noreply@example.com>"

########################################
# Billing / Stripe
########################################
STRIPE_SECRET_KEY=replace_me_stripe
STRIPE_WEBHOOK_SECRET=replace_me_stripe_webhook
STRIPE_PROMPTPAY_CURRENCY=thb
STRIPE_PROMPTPAY_FX_PROVIDER_URL=https://api.frankfurter.dev/v1/latest
STRIPE_PROMPTPAY_FX_TIMEOUT_SEC=5
STRIPE_PROMPTPAY_FX_CACHE_TTL_SEC=3600
STRIPE_PROMPTPAY_USD_TO_THB_RATE=36.00
SUBSCRIPTION_BILLING_POLL_SECONDS=900

########################################
# Frontend / CORS
########################################
FRONTEND_URL=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com,https://www.app.example.com

########################################
# Vision LLM
########################################
# Select one provider: ollama, openai, google_genai
LLM_MODEL_PROVIDER=ollama
LLM_CONNECT_TIMEOUT_SEC=10
LLM_REQUEST_TIMEOUT_SEC=300

# Ollama settings (used when LLM_MODEL_PROVIDER=ollama)
LLM_BASE_URL=http://host.docker.internal:11434
LLM_OLLAMA_MODEL=ministral-3:14b

# OpenAI settings (used when LLM_MODEL_PROVIDER=openai)
OPENAI_API_KEY=
LLM_OPENAI_MODEL=gpt-4o-mini
LLM_OPENAI_BASE_URL=

# Gemini settings (used when LLM_MODEL_PROVIDER=google_genai)
GOOGLE_API_KEY=
LLM_GOOGLE_MODEL=gemini-2.0-flash

########################################
# MT5 API
########################################
MT5_HOST=localhost
MT5_PORT=8001

########################################
# MT5 Runner Paths / Endpoints
########################################
# If the API itself runs in Docker and still needs to spawn bot containers
# on the host Docker daemon, set RUNNER_HOST_DIR to the absolute host path of
# server/docker_mt5_bot so it can be mounted at the same path in the API container.
RUNNER_HOST_DIR=/absolute/path/to/SmarfRobotTrader_Project/server/docker_mt5_bot

# Legacy/local fallback when the API runs directly on the host.
RUNNER_DIR=/opt/mt5-runner

# Optional host/port override for how bot containers call back into the API.
BOT_RUNNER_PUBLIC_HOST=host.docker.internal
BOT_RUNNER_PUBLIC_PORT=8000
BOT_RUNNER_WS_URL=
BOT_RUNNER_VISION_LLM_API_URL=
BOT_RUNNER_MODELS_DIR=
BOT_RUNNER_LLM_SEMANTIC_CACHE_FILE=
BOT_RUNNER_LLM_TEXT_LOG_FILE=
BOT_RUNNER_STATE_FILE=

########################################
# MT5 Runner Build / Startup
########################################
BOT_RUNNER_AUTO_BUILD=0
BOT_RUNNER_PULL_LATEST=1
BOT_RUNNER_FORCE_REBUILD=0
BOT_RUNNER_STRICT_SERVER_MATCH=1
BOT_RUNNER_SERVER_FALLBACKS=
BOT_RUNNER_PREWARM_SEMANTIC_ON_START=1
BOT_RUNNER_PREWARM_SEMANTIC_MAX_SECONDS=45
BOT_RUNNER_PREWARM_SEMANTIC_MAX_MISSING=24
BOT_RUNNER_PREWARM_REQUEST_TIMEOUT_SEC=20

########################################
# MT5 Runner Trading / Sync
########################################
BOT_RUNNER_MANAGE_MANUAL_POSITIONS=0
BOT_RUNNER_MANAGED_MAGIC_SET=
BOT_RUNNER_PERFORMANCE_MAGIC_SET=
BOT_RUNNER_PERFORMANCE_SCOPE=symbol
BOT_RUNNER_PERFORMANCE_SYNC_INTERVAL_SEC=120
BOT_RUNNER_PERFORMANCE_BOOT_LOOKBACK_DAYS=3650
BOT_RUNNER_MT5_HISTORY_END_AHEAD_HOURS=2

########################################
# MT5 Runner Intrabar Rules
########################################
BOT_RUNNER_INTRABAR_TAKE_PROFIT_CHANGE_PCT=0.03
BOT_RUNNER_INTRABAR_TAKE_PROFIT_PIPS=0
BOT_RUNNER_INTRABAR_TAKE_PROFIT_MONEY=0
BOT_RUNNER_INTRABAR_TRAILING_ENABLED=1
BOT_RUNNER_INTRABAR_TRAIL_KEEP_RATIO_TREND=0.35
BOT_RUNNER_INTRABAR_TRAIL_KEEP_RATIO_NORMAL=0.60
BOT_RUNNER_INTRABAR_TRAIL_KEEP_RATIO_TIGHT=0.85
BOT_RUNNER_INTRABAR_TRAIL_ARM_BUFFER_RATIO=0.10
BOT_RUNNER_INTRABAR_TRAIL_CONFIRM_POLLS=3
BOT_RUNNER_INTRABAR_MIN_BAR_AGE_SEC=300
BOT_RUNNER_INTRABAR_DISABLE_LAST_SEC=180

########################################
# MT5 Terminal / Expert Controls
########################################
MT5_FORCE_ALGO_TRADING=1
MT5_COMMON_INI_WAIT_SECONDS=120
MT5_EXPERTS_DISABLE_ON_ACCOUNT_CHANGE=0
MT5_EXPERTS_DISABLE_ON_PROFILE_CHANGE=0
MT5_EXPERTS_DISABLE_ON_CHART_CHANGE=0
MT5_EXPERTS_DISABLE_VIA_PYTHON_API=0
MT5_ALLOW_DLL_IMPORTS=
MT5_ALLOW_WEBREQUEST=

########################################
# Prisma Startup
########################################
PRISMA_GENERATE_ON_START=1
PRISMA_DB_PUSH_ON_START=1
PRISMA_SCHEMA_PATH=src/database/schema.prisma
