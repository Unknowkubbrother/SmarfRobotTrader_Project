CUSTOM_USER=
PASSWORD=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_SERVER_FALLBACKS=
MT5_STRICT_SERVER_MATCH=0
BOT_WS_URL=ws://host.docker.internal:8000/bot/ws
BOT_CONFIG_ID=182bdab8-9274-4a4e-922f-700645086705
VISION_LLM_API_URL=http://host.docker.internal:8000/vision_llm/
LIVE_MAGIC_NUMBER=
LIVE_MANAGE_MANUAL_POSITIONS=0
LIVE_MANAGED_MAGIC_SET=
LIVE_PERFORMANCE_MAGIC_SET=
LIVE_PERFORMANCE_SCOPE=symbol
LIVE_PERFORMANCE_SYNC_INTERVAL_SEC=120
LIVE_PERFORMANCE_BOOT_LOOKBACK_DAYS=3650
LIVE_MT5_HISTORY_END_AHEAD_HOURS=2
LIVE_PREWARM_SEMANTIC_ON_START=1
LIVE_PREWARM_SEMANTIC_MAX_SECONDS=45
LIVE_PREWARM_SEMANTIC_MAX_MISSING=24
LIVE_PREWARM_REQUEST_TIMEOUT_SEC=20
LIVE_MODELS_DIR=
LIVE_LLM_SEMANTIC_CACHE_FILE=
LIVE_LLM_TEXT_LOG_FILE=
LIVE_STATE_FILE=
MT5_HOST=localhost
MT5_PORT=8001
LIVE_SYMBOL=EURUSD
LIVE_TIMEFRAME=H1
MT5_SNAPSHOT_HOST_DIR=./snapshots
MT5_SNAPSHOT_PATH=/snapshots/mt5-config-snapshot.tgz
MT5_WEB_PORT=3000
MT5_INIT_TIMEOUT=900
MT5_LOGIN_RETRIES=20
MT5_RETRY_SECONDS=5
MT5_RPC_TIMEOUT_MS=180000
MT5_SKIP_PRECHECKS=0
# Remove ghost account/server cache entries (account id 0) on startup
MT5_CLEAN_ACCOUNT_CACHE_ON_START=1
MT5_COMMON_INI_WAIT_SECONDS=120
# Force-enable MT5 Expert Advisors / Algo Trading at startup
MT5_FORCE_ALGO_TRADING=1
MT5_EXPERTS_DISABLE_ON_ACCOUNT_CHANGE=0
MT5_EXPERTS_DISABLE_ON_PROFILE_CHANGE=0
MT5_EXPERTS_DISABLE_ON_CHART_CHANGE=0
MT5_EXPERTS_DISABLE_VIA_PYTHON_API=0
# Optional overrides (leave empty to keep existing MT5 value)
MT5_ALLOW_DLL_IMPORTS=
MT5_ALLOW_WEBREQUEST=
USE_SHARED_PYDEPS=1
SHARED_PYDEPS_DIR=/shared-pydeps
